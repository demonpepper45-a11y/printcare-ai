# PrintCare AI 配置示例（变量清单）。
# 程序只读取进程环境变量；真实值放在本机 .env（已被 .gitignore 忽略）
# 或部署环境的秘密配置中，由启动方式注入，不提交、不写入日志。
# 当前只有 printcare.settings 读取这些变量，模型供应商尚未选定（见 docs/architecture.md）。

# local / test / staging / production
PRINTCARE_ENVIRONMENT=local

# CRITICAL / ERROR / WARNING / INFO / DEBUG
PRINTCARE_LOG_LEVEL=INFO

# 运行数据目录（SQLite、索引等），默认 runtime/，已被 .gitignore 忽略
PRINTCARE_DATA_DIR=runtime

# 留空时使用 <PRINTCARE_DATA_DIR>/printcare.sqlite3
PRINTCARE_DATABASE_PATH=

# 模型服务配置：留空表示未配置。
PRINTCARE_MODEL_API_KEY=
# 从文件读取 Key（默认回退到 runtime/model_key.txt，该文件已被忽略）
PRINTCARE_MODEL_API_KEY_FILE=
PRINTCARE_MODEL_BASE_URL=
# 默认 deepseek-flash（DeepSeek OpenAI 兼容接口）
PRINTCARE_MODEL_NAME=deepseek-flash
